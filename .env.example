# OpenClaw integration
OPENCLAW_AGENT_ID=stock-analyst
OPENCLAW_RESEARCH_MODEL=
OPENCLAW_COMMITTEE_MODEL=
OPENCLAW_THINKING=high
TELEGRAM_TARGET=@your_username

# Persistent data. Prefer a USB SSD on Raspberry Pi.
STOCK_ANALYST_DATA_DIR=~/stock-analyst-data

# Optional behavior
SEND_ON_NO_ACTION=true
KEEP_HTML_REPORTS=true
